---
import { BookOpen, GraduationCap, Presentation, RefreshCw, Send, Square, Download, RotateCcw, Copy, Sparkles, Plus, ChevronDown } from '@lucide/astro';
import '../styles.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Education Local Assistant</title></head>
  <body>
    <header class="app-header"><div class="brand"><BookOpen size={22} /><span>Education AI <small>Local Assistant</small></span></div><span class="preview-label">Experimental preview</span></header>
    <main class="app">
      <aside class="settings">
        <details id="settings" open>
          <summary>Session settings<ChevronDown size={16} /></summary>
          <div class="settings-body">
            <div class="audience" role="group" aria-label="Audience">
              <button type="button" data-audience="professor" aria-pressed="true"><Presentation size={17} />Professor</button>
              <button type="button" data-audience="student" aria-pressed="false"><GraduationCap size={17} />Student</button>
            </div>
            <label for="skill">Skill</label><select id="skill" disabled><option>Loading skills...</option></select>
            <label for="model">Local model</label><div class="model-row"><select id="model" disabled><option>Checking Ollama...</option></select><button id="refresh" class="icon" title="Refresh local models" aria-label="Refresh local models"><RefreshCw size={17} /></button></div>
            <p id="connection" class="connection" role="status">Connecting...</p>
            <label for="context">Course notes <span>optional</span></label><textarea id="context" rows="7" maxlength="6000" placeholder="Objectives, permitted sources, course AI policy"></textarea>
            <label class="checkbox"><input id="templates" type="checkbox" />Include output templates</label>
            <p class="privacy-note">No automatic chat history. Avoid personal student data.</p>
            <a href="https://rrezartprebreza.github.io/education-ai-skills/local/" target="_blank" rel="noreferrer">Setup &amp; limitations</a>
          </div>
        </details>
      </aside>
      <section class="chat" aria-label="Conversation">
        <div class="chat-toolbar"><div><span id="category">Teaching</span><h1 id="title">Lecture Planning</h1><p id="active-model">Checking local models...</p></div><div class="toolbar-actions"><button id="export" class="icon" disabled title="Export conversation" aria-label="Export conversation"><Download size={18} /></button><button id="clear" class="icon" title="New chat" aria-label="New chat"><Plus size={20} /></button></div></div>
        <div id="transcript" class="transcript" aria-label="Messages" tabindex="0">
          <div id="empty" class="empty"><BookOpen size={32} /><h2 id="empty-title">Lecture Planning</h2><p id="summary"></p><button id="example" class="text-button"><Sparkles size={16} />Use example prompt</button></div>
          <div id="messages"></div>
        </div>
        <form id="composer" class="composer">
          <div id="notice" role="status" aria-live="polite"></div>
          <div id="error" role="alert" hidden></div>
          <button id="retry" class="text-button" type="button" hidden><RotateCcw size={15} />Retry last request</button>
          <label class="sr-only" for="prompt">Your message</label><textarea id="prompt" rows="3" maxlength="8000" placeholder="Your teaching or learning question" required></textarea>
          <div class="composer-actions"><span id="session-status">Session only</span><div><button id="stop" class="text-button" type="button" hidden><Square size={15} />Stop</button><button id="send" class="send" type="submit" disabled><Send size={16} />Send</button></div></div>
        </form>
      </section>
    </main>
    <template id="message-template"><article class="message"><div class="message-heading"><strong></strong><button class="copy icon" type="button" title="Copy message" aria-label="Copy message"><Copy size={15} /></button></div><div class="message-content"></div><small class="message-state"></small></article></template>
    <script>import '../client.mjs';</script>
  </body>
</html>
