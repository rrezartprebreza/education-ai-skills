---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { Download } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import { BASE } from '../lib/commands.mjs';
import { ROOT, renderMarkdown } from '../lib/content.mjs';
const guide = await renderMarkdown(await readFile(resolve(ROOT, 'docs/GETTING-STARTED.md'), 'utf8'), 'docs/GETTING-STARTED.md');
---
<Layout title="Start Here" description="Choose Claude Code, Codex, or the experimental local Ollama assistant for your education skills.">
  <div class="detail-heading">
    <p class="eyebrow">FOR PROFESSORS &amp; STUDENTS</p>
    <h1>Start Here</h1>
    <p class="lead">Choose your AI application and prepare your first teaching or learning session.</p>
    <a class="download-entry" href={`${BASE}downloads/`}><Download size={17} aria-hidden="true" />Get the skill bundles</a>
    <a class="download-entry local-option" href={`${BASE}local/`}>Set up the local AI assistant</a>
  </div>
  <article class="prose beginner-guide" set:html={guide} />
</Layout>
