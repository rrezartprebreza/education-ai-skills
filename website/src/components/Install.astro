---
import { Copy, Download } from '@lucide/astro';
import { installCommand } from '../lib/commands.mjs';
---
<details class="install">
  <summary><Download size={17} aria-hidden="true" /> Install a bundle</summary>
  <div class="install-body">
    <div class="install-options">
      <label>Audience<select id="install-audience"><option value="professor">Professors</option><option value="student">Students</option></select></label>
      <label>Agent<select id="install-agent"><option value="claude">Claude Code</option><option value="codex">Codex</option></select></label>
    </div>
    <div class="command"><pre id="install-command">{installCommand('claude', 'professor')}</pre><button type="button" class="icon-button" data-copy="install-command" aria-label="Copy installation commands" title="Copy installation commands"><Copy size={18} aria-hidden="true" /></button></div>
    <p class="copy-status" role="status" aria-live="polite"></p>
    <a href="https://github.com/rrezartprebreza/education-ai-skills#installation">Individual skills and client requirements</a>
  </div>
</details>
<script>
  import { installCommand } from '../lib/commands.mjs';
  const agent = document.querySelector<HTMLSelectElement>('#install-agent');
  const audience = document.querySelector<HTMLSelectElement>('#install-audience');
  const command = document.querySelector('#install-command');
  function update() {
    if (agent && audience && command) command.textContent = installCommand(agent.value, audience.value);
    const status = document.querySelector('.install .copy-status');
    if (status) status.textContent = '';
  }
  agent?.addEventListener('change', update);
  audience?.addEventListener('change', update);
</script>
